### RAILS UPGRADE ALIASES ----------------------------------------------------------------------

export MAIN_BRANCH='master'
export UPGRADE_BRANCH='152312-update-app-with-turbo-rails'

fucntion gbranch () {
  ref=$(git symbolic-ref HEAD 2> /dev/null) || return
  echo "${ref#refs/heads/}"
}

alias gmaster="bcr && gco master && git pull && gco $MAIN_BRANCH && gmerge master"

function gmain () {
  current_branch=$(gbranch) &&
  bcr && gmaster && gpush && gco $current_branch && git rebase $MAIN_BRANCH
}

function minfo () {
  riski &&
  echo ''
  echo '******  Rails Upgrade Aliases **************************************'
  echo "PROJDIR = $HOME/riskonnect.projects"
  echo "CATSAAS  = $PROJDIR/BCR-Web"
  echo "bcr      = cd $BCRWEB"
  echo "gmaster = bcr && gco master && git pull && gco $MAIN_BRANCH && gmerge master"
  echo "gmain   = bcr && gco $MAIN_BRANCH && gpush && gco $(gbranch) && gmerge $MAIN_BRANCH"
}
