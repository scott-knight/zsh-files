# BCR-Web FUNCTIONS ===============================================================================
function bcrwssl() {
  local repo="$1"
  if [[ -n $repo ]]; then
    eval $repo && rails s -b 'ssl://localhost:3000?key=localhost.key&cert=localhost.crt'
  fi
}

function bcrwcss() {
  local repo="$1"
  if [[ -n $repo ]]; then
    eval $repo &&
    echo ''
    echo 'Cleaning up app/assests/builds css assets. Please wait...' &&
    rm -rf app/assets/builds/**/*.css
    echo 'Done!'
    echo ''
    echo 'Rebulding app/assests/builds css assets with `yarn watch:css`'
    yarn watch:css
  fi
}

function bcrwjs() {
  local repo="$1"
  if [[ -n $repo ]]; then
    eval $repo &&
    echo ''
    echo 'Cleaning up app/assests/builds js assets. Please wait...' &&
    rm -rf app/assets/builds/**/*.js
    echo 'Done!'
    echo ''
    echo 'Rebulding app/assests/builds js assets with `yarn build:dev --watch`'
    yarn build:dev --watch
  fi
}

function bcrwclobber() {
  local repo="$1"
  if [[ -n $repo ]]; then
    echo ''
    echo 'Cleaning up assets. Please wait...' &&
    eval $repo &&
    if [ -d "public/assets" ]; then
      echo 'Running rails assets:clobber' &&
      rails assets:clobber
    fi

    if [ -d "app/assets/builds" ]; then
      echo 'Cleaning app/assets/build. Please wait...' &&
      rm -rf app/assets/builds && mkdir app/assets/builds && touch app/assets/builds/.gitkeep
    fi
    echo 'Done!'
    echo ''
  fi
}

function bcrwindex() {
  local repo="$1"
  if [[ -n $repo ]]; then
    eval $repo && rake elasticsearch:reset
  fi
}

function bcrwenvs() {
  local repo="$1"
  if [[ -n $repo ]]; then
    eval $repo &&
    echo ''
    echo 'Setting ENV VARS in catalyst_env_vars.sh'
    if [[ ! -f catalyst_env_vars.sh ]]; then
      cp -i catalyst_env_vars.sh{.example,}
    fi

    echo "Done!\n"
  fi
}
