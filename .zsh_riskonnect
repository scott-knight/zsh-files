### FEATURE TOGGLES ------------------------------------------------------------------------------

function add_feature_toggle () {
  bcr &&
  echo "Running: rake 'setup_catalyst:create_feature_toggle[$1]'. Please wait..."
  if [[ -z $1 ]]; then
    echo 'Unable to add a feature toggle without a name. Ex: new_toggle_name'
  else
    rake "setup_catalyst:create_feature_toggle[$1]"
  fi
}
