#! /bin/zsh

# ##### Ruby / rbenv / gems #####

function delete_gems () {
  for x in `gem list --no-versions`; do gem uninstall $x -a -x -I; done
}
alias delgems='delete_gems'
alias delg='delete_gems'
alias removegems='delete_gems'

function reload_gems () {
  delete_gems && bundle install
}

# Remove a conflicting gem from the Ruby *core* gemdir only.
# Project gemsets stay first on GEM_PATH; core defaults stay available.
# Use this when junk was `gem install`ed into core and fights the gemset.
# Usage: clean_gem some-conflicting-gem
function clean_gem () {
  local name="$1"
  local gemdir
  if [[ -z "$name" ]]; then
    echo "Usage: clean_gem <gem-name>" >&2
    return 1
  fi
  gemdir="$(rbenv prefix)/lib/ruby/gems/$(ruby -e 'print Gem.ruby_api_version')"
  if [[ ! -d "$gemdir" ]]; then
    echo "Default gemdir not found: $gemdir" >&2
    return 1
  fi
  echo "Uninstalling $name from $gemdir ..."
  gem uninstall "$name" -a -i "$gemdir" --force --executables
  echo "Done. Remaining $name:"
  gem list "$name" -a
}
alias cleangem='clean_gem'
alias delgem='clean_gem'

function install_rbenv () {
  cd $HOME && git clone https://github.com/rbenv/rbenv.git $HOME/.rbenv
}

function install_rbenv_plugins () {
  cd $HOME && mkdir $HOME/.rbenv/plugins &&
  git clone https://github.com/rbenv/ruby-build.git "$(rbenv root)"/plugins/ruby-build &&
  git clone https://github.com/jf/rbenv-gemset.git "$(rbenv root)"/plugins/rbenv-gemset &&
  git clone https://github.com/rkh/rbenv-use.git "$(rbenv root)/plugins/rbenv-use" &&
  install_rbenv_gemset_filter &&
  cd $HOME/.rbenv && cd $HOME
}

# Gemset first; core still on GEM_PATH. Filter hides core junk not in Gemfile.lock.
# Plugin name sorts after rbenv-gemset so the exec hook runs second.
function install_rbenv_gemset_filter () {
  local src="${ZSH_FILES:-$HOME/scott.projects/zsh-files}/rbenv-plugins/rbenv-gemset-filter"
  local dest="$(rbenv root)/plugins/rbenv-gemsetz-filter"
  if [[ ! -d "$src" ]]; then
    echo "rbenv-gemset-filter source missing: $src" >&2
    return 1
  fi
  rm -f "$(rbenv root)/plugins/rbenv-gemset/etc/rbenv.d/exec/zz-strict.bash"
  rm -f "$(rbenv root)/plugins/rbenv-gemset-strict"
  ln -sfn "$src" "$dest"
  echo "linked $dest -> $src"
}
alias gemset_filter_install='install_rbenv_gemset_filter'

function reload_rbenv () {
  echo 'Deleteing and reinstalling RBENV. Please wait...'
  echo ''
  cd $HOME &&
  rm -rf $HOME/.rbenv &&
  install_rbenv &&
  install_rbenv_plugins &&
  echo 'Done!'
}

function update_rbenv () {
  local curr="$PWD"
  echo ""
  echo 'Updating RBENV, please wait...'
  { cd "$(rbenv root)" && git pull; }
  cd "$curr"
  echo "Done updating RBENV!"
  update_ruby_build
  update_rbenv_gemset
  update_rbenv_use
  install_rbenv_gemset_filter
}

function update_ruby_build () {
  local curr="$PWD"
  echo ""
  echo 'Updating ruby-build, please wait...'
  { cd "$(rbenv root)"/plugins/ruby-build && git pull; }
  cd "$curr"
  echo "Done updating ruby-build!"
}

function update_rbenv_gemset () {
  local curr="$PWD"
  echo ""
  echo 'Updating rbenv-gemset, please wait...'
  { cd "$(rbenv root)"/plugins/rbenv-gemset && git pull; }
  cd "$curr"
  echo "Done updating rbenv-gemset!"
}

function update_rbenv_use () {
  local curr="$PWD"
  echo ""
  echo 'Updating rbenv-use, please wait...'
  { cd "$(rbenv root)"/plugins/rbenv-use && git pull; }
  cd "$curr"
  echo "Done updating rbenv-use!"
}

function rbenvi () {
  echo ''
  echo '****** RBENV ALIASES **************************************'
  echo 'rbv     = rbenv version             # shows the current ruby version'
  echo 'rbvs    = rbenv versions            # shows installed ruby versions'
  echo 'rbvlist = rbenv install --list-all  # show all availabe ruby versions'
  echo 'rehash  = rbenv rehash              # refreshes rbenv'
  echo 'active  = rbenv gemset active       # shows the active gemset'
  echo ''
}
alias rbvi='rbenvi'
alias rbenvs='rbenvi'

function cedit () {
  EDITOR="code --wait" bin/rails credentials:edit
}

function ecreds () {
  echo ''
  echo '******  Editing Rails Credentials  **************************************'
  echo 'cedit = EDITOR="code --wait" bin/rails credentials:edit'
  echo 'vedit = EDITOR=vi bin/rails credentials:edit'
}
