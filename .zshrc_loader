#! /bin/zsh

# Helpers live in $ZSH_FILES (default: ~/scott.projects/zsh-files).
#
# 1. zsh_fn_base_helpers          — always sourced
# 2. zsh_fn_helpers_for_$ENV      — appended when LOCAL_ENV matches (set in ~/.zshrc_envs)
# 3. zsh_fn_helpers_skip          — always skipped
# 4. zsh_fn_helpers_skip_for_$ENV — skipped only for that LOCAL_ENV
#
# Example: export LOCAL_ENV="rk"
# New profile: add *_for_<name> / *_skip_for_<name> arrays and set LOCAL_ENV.
# DB swap (rk): both DB helpers in the pack; inactive one in skip_for_rk.

zsh_fn_base_helpers=(
  .zsh_alias_list_base
  .zsh_ponytail
  .zsh_ruby
  .zsh_nvm
  .zsh_git
  .zsh_redis
  .zsh_memcached
)

zsh_fn_helpers_skip=(
)

zsh_fn_helpers_for_rk=(
  .zsh_alias_list_rk
  .zsh_podman
  .zsh_mysql57
  .zsh_riskonnect
  .zsh_mariadb10-5
)

# Currently on MySQL 5.7 — skip MariaDB under rk. Flip to .zsh_mysql57 for MariaDB.
zsh_fn_helpers_skip_for_rk=(
  .zsh_mariadb10-5
)

zsh_fn_helpers_for_sk=(
  .zsh_alias_list_sk
  .zsh_postgres
  .zsh_things_to_do
)

if [[ -n ${LOCAL_ENV:-} ]]; then
  _zsh_fn_pack="zsh_fn_helpers_for_${LOCAL_ENV}"
  if (( ${(P)+_zsh_fn_pack} )); then
    zsh_fn_base_helpers+=(${(P)_zsh_fn_pack[@]})
  fi
  _zsh_fn_skip_pack="zsh_fn_helpers_skip_for_${LOCAL_ENV}"
  if (( ${(P)+_zsh_fn_skip_pack} )); then
    zsh_fn_helpers_skip+=(${(P)_zsh_fn_skip_pack[@]})
  fi
fi
unset _zsh_fn_pack _zsh_fn_skip_pack

for _zsh_fn in "${zsh_fn_base_helpers[@]}"; do
  (( ${zsh_fn_helpers_skip[(Ie)$_zsh_fn]} )) && continue
  _zsh_fn_path="$ZSH_FILES/$_zsh_fn"
  if [ -f "$_zsh_fn_path" ]; then
    source "$_zsh_fn_path"
  else
    echo "not sure what happened with ${_zsh_fn_path}"
  fi
done
unset _zsh_fn _zsh_fn_path

function reload_zsh_tools () {
  echo 'Deleteing and reinstalling ZSH tools. Please wait...'
  echo ''
  cd $HOME &&
  rm -rf $HOME/.zsh &&
  install_zsh_tools &&
  echo 'Done!'
  echo ''
}

function install_zsh_tools () {
  cd $HOME && mkdir $HOME/.zsh &&
  git clone https://github.com/zsh-users/zsh-autosuggestions $HOME/.zsh/zsh-autosuggestions &&
  echo "" &&
  git clone https://github.com/zsh-users/zsh-syntax-highlighting.git $HOME/.zsh/zsh-syntax-highlighting &&
  cd $HOME
}

function update_zsh_autosuggestions () {
  CURR_DIR="$PWD" &&
  echo ""
  echo 'Updating zsh-autosuggestions, please wait...'
  cd $HOME/.zsh/zsh-autosuggestions && git pull &&
  cd "$CURR_DIR"
  echo "Done updating zsh-autosuggestions!"
}

function update_zsh_syntax_highlighting () {
  CURR_DIR="$PWD" &&
  echo ""
  echo 'Updating zsh-syntax-highlighting, please wait...'
  cd $HOME/.zsh/zsh-syntax-highlighting && git pull &&
  cd "$CURR_DIR"
  echo "Done updating zsh-syntax-highlighting!"
}

function update_zsh_tools () {
  CURR_DIR="$PWD" &&
  update_zsh_autosuggestions &&
  update_zsh_syntax_highlighting
}

function upgrade_brew() {
  echo ''
  echo "Updating BREW"
  brew update &&
  echo ''
  echo "Upgrading BREW installs"
  brew upgrade --greedy &&
  echo ''
  echo "Cleaning up BREW"
  brew cleanup &&
  echo "Completed BREW updates!"
}

function update() {
  echo "Upgrading ALL the things..."
  update_zsh_tools &&
  update_rbenv &&
  update_ponytail &&
  upgrade_brew &&
  updateNVM &&
  upgrade_node_lts &&
  # upgrade_node &&
  echo ''
  echo "All updates complete!!"
}

function fixchrome () {
  echo 'Running command sudo xattr -r -d com.apple.quarantine $(which chromedriver)'
  echo 'You might be asked to provide your system password'
  sudo xattr -r -d com.apple.quarantine $(which chromedriver)
  echo 'Done!'
}
alias fixcd="fixchrome"
alias chromefix="fixchrome"

function rebuild_index () {
  sudo mdutil -Eai off &&
  sudo mdutil -Eai on &&
  mdutil -as
}
alias rebi="rebuild_index"

function scotts () {
  echo ''
  echo "******  Scott Projects commands  **************************************"
  echo 'SCOTTPROJ = ~/scott.projects'
  echo 'scott     = cd $SCOTTPROJ'
  echo 'sdev      = scott && ll'
  echo 'unin      = cd $SCOTTPROJ/unipay-nuxt-ui'
  echo 'unia      = cd $SCOTTPROJ/unipay-api'
  echo 'unic      = cd $SCOTTPROJ/unipay'
  echo 'sui       = cd $SCOTTPROJ/sandbox-ui'
  echo 'sapi      = cd $SCOTTPROJ/sandbox-api'
  echo 'oapp      = cd $SCOTTPROJ/online-application-service'
  echo 'appc      = cd $SCOTTPROJ/application-center-ui'
  echo 'sadmin    = cd $SCOTTPROJ/rh_client_superadmin'
  ecreds
  services
  ngroks
  echo ''
}

function brews () {
  echo ''
  echo '****** REDIS **************************************'
  echo 'redstart   = brew services start redis'
  echo 'redstop    = brew services stop redis'
  echo 'redrestart = redstop && redstart'
  echo 'redstat    = checks the current status of redis'
  echo ''
  echo '****** Elastic Search **************************************'
  echo 'esstart    = brew services start elasticsearch-full (or your es alias)'
  echo 'esstop     = brew services stop elasticsearch-full'
}

# alias esstart="brew services start elastic/tap/elasticsearch-full"
# alias esstop="brew services stop elastic/tap/elasticsearch-full"

function bstart () {
  echo 'Starting Brew services. Please wait...'
  bredstart &&
  esstart &&
  mystart
  echo "Done!\n"
}
alias startall="bstart"


function bstop () {
  echo 'Stopping Brew services. Please wait...'
  bredstop &&
  esstop &&
  mystop
  echo "Done!\n"
}
alias stopall="bstop"
