function brews () {
  echo ''
  echo '****** REDIS **************************************'
  echo 'redstart   = brew services start redis'
  echo 'redstop    = brew services stop redis'
  echo 'redrestart = redstop && redstart'
  echo 'redstat    = checks the current status of redis'
  echo ''
