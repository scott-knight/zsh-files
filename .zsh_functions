function bstart () {
  echo 'Starting Brew services. Please wait...'
  bredstart &&
  esstart &&
  mystart
  echo "Done!\n"
}
alias startall="bstart"


function bstop () {
  echo 'Stopping Brew services. Please wait...'
  bredstop &&
  esstop &&
  mystop
  echo "Done!\n"
}
alias stopall="bstart"
